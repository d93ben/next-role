{
  "name": "next-role",
  "version": "1.4.4",
  "private": true,
  "description": "A portable, agent-operated job search workspace with a local HTML dashboard.",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "Next Role contributors",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "node scripts/career.mjs init",
    "start": "node scripts/launch.mjs",
    "live": "node scripts/serve.mjs",
    "open": "node scripts/launch.mjs",
    "build": "node scripts/career.mjs build",
    "validate": "node scripts/career.mjs validate",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs",
    "desktop": "electron .",
    "desktop:win": "electron-builder --win portable --x64 --publish never",
    "desktop:mac": "electron-builder --mac zip --universal --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.1",
    "playwright-core": "1.65.1"
  },
  "build": {
    "appId": "io.github.d93ben.nextrole",
    "productName": "Next Role",
    "directories": {"output":"release/desktop"},
    "files": ["desktop/**/*", "scripts/**/*", "templates/**/*", "ui/**/*", "docs/**/*", "workflows/**/*", "AGENTS.md", "CLAUDE.md", "START-HERE.md", "MEMORY.md", "README.md", "LICENSE", "package.json"],
    "win": {"artifactName":"NextRole.exe"},
    "mac": {"category":"public.app-category.productivity", "artifactName":"NextRole-Mac.zip"}
  },
  "license": "MIT"
}
